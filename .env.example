# ======================================
# Gera Hinjewadi – Environment Variables
# ======================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- Admin Authentication ----------
ADMIN_PASSWORD=admin1234
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_production

# ---------- WhatsApp Notifications ----------
# Sales team WhatsApp number (with country code)
SALES_WHATSAPP_TO=+919673000053

# Twilio Gateway (optional – for live WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
